{
  "mcpServers": [
    {
      "name": "weather-server",
      "enabled": true,
      "transport": {
        "type": "stdio",
        "command": "docker",
        "args": ["run", "--rm", "-i", "mcp/weather-server"]
      },
      "capabilities": ["weather", "forecast", "temperature"],
      "description": "Get weather information and forecasts for any location",
      "healthCheck": {
        "timeout": 5000,
        "retries": 2
      }
    },
    {
      "name": "time-server", 
      "enabled": true,
      "transport": {
        "type": "stdio",
        "command": "docker",
        "args": ["run", "--rm", "-i", "mcp/time-server"]
      },
      "capabilities": ["current_time", "date", "timezone"],
      "description": "Get current date, time, and timezone information",
      "healthCheck": {
        "timeout": 5000,
        "retries": 2
      }
    },
    {
      "name": "calculator-server",
      "enabled": true,
      "transport": {
        "type": "stdio", 
        "command": "docker",
        "args": ["run", "--rm", "-i", "mcp/calculator-server"]
      },
      "capabilities": ["calculate", "math", "arithmetic"],
      "description": "Perform mathematical calculations and solve arithmetic problems",
      "healthCheck": {
        "timeout": 5000,
        "retries": 2
      }
    }
  ],
  "localTools": [
    {
      "name": "GetOrder",
      "enabled": true,
      "class": "Intentive.Core.Tools.GetOrderTool",
      "method": "GetOrderAsync",
      "capabilities": ["order", "status", "track", "package", "shipment"],
      "description": "Look up order status and tracking information by order ID",
      "parameters": {
        "orderId": {
          "type": "string",
          "required": true,
          "description": "The order ID to look up"
        }
      }
    }
  ],
  "intentGeneration": {
    "enabled": true,
    "examplesPerCapability": 5,
    "customExamples": {
      "weather": [
        "what's the weather in {location}?",
        "weather forecast for {location}",
        "temperature in {location}",
        "is it raining in {location}?",
        "how's the weather today?"
      ],
      "current_time": [
        "what time is it?",
        "current time",
        "what's today's date?",
        "today's date",
        "what day is it?"
      ],
      "calculate": [
        "calculate {expression}",
        "what's {number} plus {number}?",
        "solve {expression}",
        "math problem: {expression}",
        "{number} * {number}"
      ],
      "order": [
        "order status {orderId}",
        "track order {orderId}", 
        "check my order {orderId}",
        "where is order {orderId}?",
        "status of order {orderId}"
      ]
    }
  }
}